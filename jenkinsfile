pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        S3_BUCKET = 'frontend-project-bucket-2026'
        CLOUDFRONT_DISTRIBUTION_ID = 'E245NQZ6ND74FS'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/seethala-hub/frontend-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Upload to S3') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        aws s3 sync build/ s3://${S3_BUCKET}/ --delete
                    '''
                }
            }
        }

        stage('CloudFront Invalidation') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        aws cloudfront create-invalidation \
                        --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                        --paths "/*"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend deployed successfully!'
        }

        failure {
            echo 'Frontend deployment failed!'
        }
    }
}
